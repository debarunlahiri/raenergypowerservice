# PHP 7.4 (uncomment the line that works for your cPanel setup)
# AddHandler application/x-httpd-php74 .php
# AddHandler application/x-httpd-php7.4 .php
# AddHandler application/x-httpd-php .php

# Enable rewrite engine
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect to HTTPS (uncomment on production with SSL)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Disable directory listing
Options -Indexes

# Disable server signature
ServerSignature Off

# Deny access to hidden files (Apache 2.4 syntax)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Deny access to sensitive files (Apache 2.4 syntax)
<FilesMatch "\.(ini|log|sh|sql|env|gitignore|gitattributes)$">
    Require all denied
</FilesMatch>
